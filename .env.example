PORT=3001
# Server-side only. Never expose these to the client.

# Postgres. On Replit this is set automatically when the database is added.
# Without it, development uses an in-memory store that resets on restart.
# DATABASE_URL=

# Organizer sign-in: "Organization Name=access-code;Another Org=another-code"
# Development defaults: Demo Org A=demo-a;Demo Org B=demo-b
# ORGANIZER_ACCESS_CODES=
# Required in production: a long random string used to sign session cookies.
# SESSION_SECRET=

# Any OpenAI-compatible chat completions endpoint with image input.
# On Replit, AI_INTEGRATIONS_OPENAI_API_KEY / AI_INTEGRATIONS_OPENAI_BASE_URL are used automatically if present.
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# Public calendar feed for npm run import:engagesc
# ENGAGESC_ICS_URL=
