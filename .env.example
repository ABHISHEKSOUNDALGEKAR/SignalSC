PORT=3001
# Server-side only. Never expose these to the client.

# Postgres. On Replit this is set automatically when the database is added.
# Without it, development uses an in-memory store that resets on restart.
# DATABASE_URL=

# Organizer sign-in: Organization Name=private-code;Another Org=another-private-code
# Supply private, unique codes through Replit Secrets; never commit real values.
# Required in production; without it, development organizer sign-in is disabled.
# Organization names must produce distinct lowercase, hyphenated identifiers.
# ORGANIZER_ACCESS_CODES=
# Required in production: a long random string used to sign session cookies.
# SESSION_SECRET=

# Any OpenAI-compatible chat completions endpoint with image input.
# On Replit, AI_INTEGRATIONS_OPENAI_API_KEY / AI_INTEGRATIONS_OPENAI_BASE_URL are used automatically if present.
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# For BluesMinds, use your BluesMinds key as MODEL_API_KEY and set:
# MODEL_BASE_URL=https://api.bluesminds.com/v1
# MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# This model uses its documented non-reasoning mode for short JSON responses.
# Confirm model access with your provider; listed models may be unavailable.
# Use an image-capable model that supports JSON chat completions.
# /api/health reports key presence, not provider credit balance or availability.
# An exhausted account or unavailable provider returns 503 for extraction.
# Search falls back to local rules; without a key, extraction returns a manual draft.

# Shared across search interpretation, answer writing, flyer extraction, and
# imported-calendar enrichment. PostgreSQL reservations are shared across
# restarts/replicas using the same database. Every outbound attempt counts,
# including failures and retries. Capacity is rejected without a waiting queue.
# MODEL_REQUEST_BUDGET=120
# MODEL_BUDGET_WINDOW_MS=3600000
# MODEL_MAX_CONCURRENT=4
# Budget 0 disables all paid calls. Invalid limits fail startup.
# Use identical limits on every replica; mismatches fail closed until the next
# budget window. Crashed concurrency slots expire after 60 seconds; spent
# attempts remain until the window resets using database time. PostgreSQL errors
# block paid calls rather than falling back to independent local counters.
# Database-free development only uses temporary per-process limits.
# These are request limits, not a dollar/token ceiling. Use provider-side billing
# limits as well. A timed-out/crashed request may still be running at the provider.

# Public event feeds are imported on start and refreshed hourly: the EngageSC
# school-wide feed and USC's public calendar (calendar.usc.edu).
# Set ENGAGESC_ICS_URL to replace the EngageSC feed, or "off" to disable all feeds.
# ENGAGESC_ICS_URL=https://engage.usc.edu/ical/usc/ical_usc.ics
# Or list every feed yourself, comma-separated:
# EVENT_FEED_URLS=https://engage.usc.edu/ical/usc/ical_usc.ics,https://calendar.usc.edu/calendar.ics
